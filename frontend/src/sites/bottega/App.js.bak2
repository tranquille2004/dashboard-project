              <div className="p-6 text-center">
                <div className="flex justify-center mb-4">
                  <Utensils className="w-12 h-12 text-[#7D3C32]" />
                </div>
                <h3 className="text-xl font-bold text-gray-900 mb-2">Verse Bereiding</h3>
                <p className="text-gray-600">Dagelijks vers bereid</p>
